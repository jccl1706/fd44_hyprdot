[Unit]
# Applies power-source-dependent settings (power profile + screen brightness)
# and keeps watching for the charger being plugged or unplugged.
#
# Bound to graphical-session.target so it starts with the Hyprland session and
# stops with it - brightnessctl is pointless without a session, and there is
# nothing to do while logged out.
Description=Apply power profile and brightness based on AC/battery
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Reached through ~/.config/hypr, which is a symlink into the checkout: the
# kernel resolves the symlink before applying "..", so this lands in the
# repo's bin/ wherever the repo actually lives. The path used to be
# %h/Work/fd44_hyprdot/bin, which was correct only because the installer
# derives the clone directory from the repo URL's basename - a rename or a
# fork installed under any other name would have broken this silently.
# systemd keeps the ".." rather than normalising it away lexically; verified.
ExecStart=%h/.config/hypr/../bin/power-mode.sh watch

# The watcher is a pipeline around `udevadm monitor`; if that ever dies, the
# service should come back rather than silently stop reacting to the charger.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
