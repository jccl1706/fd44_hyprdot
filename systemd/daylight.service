[Unit]
# Picks a random wallpaper every interval_minutes, from the darker half of the
# collection once the sun is down, and switches the palette if any slot names
# one - see bin/daylight.py for how, and daylight/slots.conf for the settings.
#
# A USER UNIT: it writes ~/.local/state/wallpaper, which is this user's
# desktop, and runs bin/theme.sh, which writes this user's configuration.
Description=A random wallpaper through the day, and the palette by the sun
ConditionPathExists=%h/.config/fd44

[Service]
Type=oneshot
ExecStart=%h/.config/fd44/bin/daylight.py

# Not Restart=on-failure: the timer comes round again in five minutes, which
# is sooner than any retry would be worth, and a failure that persists should
# be visible in `systemctl --user --failed` rather than hidden by retries.
