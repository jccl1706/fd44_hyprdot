[Desktop Entry]
# =========================================================================
# YouTube as a web app
# =========================================================================
#
# Chromium's --app mode: a window with no tab strip, no address bar and no
# bookmarks, so it behaves like an application rather than a browser that
# happens to be showing one page.
#
# THE DEFAULT PROFILE, deliberately - no --user-data-dir. A separate profile
# would be a separate YouTube login, separate history and separate
# subscriptions, which is the opposite of what a shortcut to your own
# account is for. The cost is that it shares cookies with ordinary browsing,
# which for this site is the point.
#
# THE BROWSER IS NOT NAMED HERE. Fedora calls the binary chromium-browser
# and ships no "chromium" symlink; NixOS and Debian call it chromium. This
# entry is shared by every machine in the repository, so it goes through
# bin/browser.sh, which picks whichever is installed.
#
# BY NAME, NOT BY PATH. bin/link-dotfiles.sh links that script into
# ~/.local/bin as "fd44-browser", which is on PATH for the shell and for the
# systemd user manager that the launcher starts applications through. The
# alternative - Exec=sh -c '...$HOME/...' - is rejected by
# desktop-file-validate: the Exec key reserves the single quote and requires
# a literal $ to be written \\$, which is a quoting puzzle for no gain.
#
# --class IS IGNORED HERE and there is no use adding it. Chromium on Wayland
# derives the app_id in --app mode from the URL, so this window comes up as
# chrome-www.youtube.com__-Default whatever is passed. That string is what
# StartupWMClass below has to say, and what a Hyprland window rule would have
# to match; it was read off `hyprctl clients` rather than guessed.
#
# THE ICON IS A STAND-IN. Nothing installed here ships a YouTube icon and
# this repository does not carry other people's logos. video-display is a
# scalable Adwaita icon that at least reads as "something you watch". To use
# the real one: open the site in Chromium, then its menu > Cast, save and
# share > Install page as app - that writes its own desktop file with the
# favicon, and this one can be deleted. Or drop any image at
# ~/.icons/hicolor/scalable/apps/youtube.svg and change Icon= to youtube;
# that directory is searched and is not one bin/icon-bridge.sh manages.

Type=Application
Name=YouTube
GenericName=Video
Comment=YouTube in its own window, without the browser around it
Exec=fd44-browser --app=https://www.youtube.com/
Icon=video-display
Terminal=false
Categories=AudioVideo;Video;
Keywords=video;youtube;music;watch;
StartupWMClass=chrome-www.youtube.com__-Default
