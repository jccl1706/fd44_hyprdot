# Editor / OS noise
*.swp
*.swo
*~
.DS_Store

# Backups made while editing configs
*.bak
*.orig
*.rej

# Anything a tool generates into the config dir at runtime.
# Hyprland itself writes nothing here, but hyprpm (plugin manager) does.
hypr/hyprpm/
hypr/.hyprpm*

# Generated by bin/theme.sh, not authored. ~/.config/kitty is a symlink into
# this checkout, so the theme file kitty includes lands in the repo whether we
# like it or not - and it is derived state that changes on every theme switch,
# which would make each switch show up as a diff. The themes it is generated
# FROM (themes/*.conf) are tracked; this is not.
kitty/theme.conf

# Generated by bin/theme.sh, like kitty/theme.conf above and for the same
# reason: ~/.config/hypr is a symlink into this checkout, so the colour file
# hyprlock sources lands in the repo. The theme files it is generated FROM are
# tracked; this is not.
hyprlock-colors.conf
