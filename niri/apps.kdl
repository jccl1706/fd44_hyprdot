// =========================================================================
// niri binds - applications, windows and the hardware keys
// =========================================================================
//
// Include this from ~/.config/niri/config.kdl:
//
//     include "~/Work/fd44_hyprdot/niri/apps.kdl"
//
// niri/binds.kdl covers the bar and the workspaces. This is everything else
// hypr/binds.lua binds: the apps, the window management, brightness and
// screenshots. The keys are the same ones, so muscle memory carries over.
//
// WHERE THE TWO COMPOSITORS DISAGREE, THE DISAGREEMENT IS LEFT VISIBLE rather
// than approximated. niri is a scrollable strip of columns and Hyprland is a
// tree, so "move the window left" is not the same operation and some binds have
// no counterpart at all - those are named below with what was dropped, so the
// next person does not go looking for a translation that does not exist.
//
// The action names here were read out of `niri msg action --help` on the running
// compositor, not from memory.

binds {
    // --- the three applications ------------------------------------------
    //
    // The commands are hypr/hyprland.lua's Apps table: kitty, nautilus with a
    // new window, and bin/browser.sh, which picks whichever browser is
    // installed rather than naming one.
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    // THE SESSION TERMINAL, the same one niri/autostart.kdl opens at login.
    // Mod+Return is a fresh terminal wherever you are; this is the one that
    // goes to workspace 1 at full width and attaches to the tmux session the
    // work lives in.
    //
    // --app-id kitty-framework is not decoration: it is what the window rule in
    // niri/rules.kdl matches. Launch kitty without it and you get an ordinary
    // terminal in the current column.
    //
    // `tmux new-session -A` attaches if "framework" exists and creates it
    // otherwise, so pressing this twice gives you the session you already have
    // rather than a second one - and the claude command only runs when the
    // session is new.
    Mod+Shift+Return hotkey-overlay-title="Session terminal" {
        spawn "kitty" "--app-id" "kitty-framework" "-e" "tmux" "new-session" "-A" "-s" "framework" "claude" "--resume" "4c3c50be-ace6-48fa-a669-28809a94ba06";
    }
    Mod+E hotkey-overlay-title="Files" { spawn "nautilus" "--new-window"; }
    Mod+B hotkey-overlay-title="Browser" { spawn-sh "$HOME/Work/fd44_hyprdot/bin/browser.sh"; }

    // YouTube as its own window, the same --app= trick as on Hyprland.
    Mod+Y hotkey-overlay-title="YouTube" { spawn-sh "$HOME/Work/fd44_hyprdot/bin/browser.sh --app=https://www.youtube.com/"; }

    // The theme toggle. One of the scripts that calls hyprctl, so parts of it
    // will complain under niri until that is ported - the colours it writes for
    // GTK, kitty and quickshell do not involve the compositor.
    Mod+T hotkey-overlay-title="Toggle dark/light theme" { spawn-sh "$HOME/Work/fd44_hyprdot/bin/theme.sh toggle"; }

    // --- windows ----------------------------------------------------------
    Mod+W { close-window; }
    Mod+F { fullscreen-window; }

    // MAXIMIZE IS NOT FULLSCREEN, which is why both are worth having. niri
    // binds maximize-column to Mod+F; this configuration took that key for
    // fullscreen-window to match the Hyprland binds it was ported from, so
    // maximize was shadowed and unreachable.
    //
    //   fullscreen-window   the window covers the output - the bar goes with
    //                       everything else, which is what you want for a video
    //                       and not what you want while working
    //   maximize-column     the column grows to the full working area and STOPS
    //                       AT THE BAR, so the clock, the tray and the battery
    //                       are still there
    //
    // Mod+Alt+F, following the pair above it: the action niri puts on a key
    // this configuration has taken, one modifier along, keeping the letter.
    Mod+Alt+F hotkey-overlay-title="Maximize the column, keeping the bar" { maximize-column; }
    Mod+V { toggle-window-floating; }

    // Mod+J was `colresize +1` on Hyprland. niri's nearest is cycling the
    // column through its preset widths, which is the idiom niri is built around.
    Mod+J { switch-preset-column-width; }

    // Hyprland's consume/expel moved a window in and out of the group beside it;
    // niri's names describe the same motion on a strip.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // THE ONE-WAY VERSIONS, which the combined pair above cannot express.
    //
    // consume-or-expel decides for you: with a window beside the column it
    // pulls it in, and with the column already holding the focused window it
    // pushes it out. That is the right default and it is why those two keys
    // exist - but it means there is no way to say "pull the next window in"
    // when the obvious reading is "push this one out", and vice versa.
    //
    // niri binds these to Mod+Comma and Mod+Period. binds.kdl takes both for
    // the wallpaper and theme pickers and is included later, so they were
    // shadowed - found by sweeping every bind rather than by missing them,
    // which is how a lost capability usually stays lost.
    //
    // Mod+Alt KEEPS niri's OWN LETTERS. The comma and the full stop are where
    // they would be in an unmodified niri, one modifier along, so muscle memory
    // from the documentation still lands somewhere sensible. Mod+Shift+brackets
    // was the alternative and says nothing about which direction is which.
    Mod+Alt+Comma  hotkey-overlay-title="Pull the next window into this column" { consume-window-into-column; }
    Mod+Alt+Period hotkey-overlay-title="Push this window out of the column"    { expel-window-from-column; }

    // Mod+A was `fit all`, which sized the layout to fit every window. niri has
    // no equivalent - the strip is not meant to fit on screen. expand-column-to-
    // available-width is the closest useful thing: give this column the room
    // nothing else is using.
    Mod+A { expand-column-to-available-width; }

    // DIRECTION IS WHERE THE MODELS PART. Left and right move between COLUMNS on
    // the strip; up and down move between windows WITHIN a column. On Hyprland
    // all four were the same kind of motion through a tree.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // --- between monitors -------------------------------------------------
    //
    // niri binds these to Mod+Shift+arrows, which the four lines above claim
    // for moving a window, so the ARROW form of focus-monitor was shadowed.
    //
    // THE CAPABILITY WAS NEVER LOST, and the commit that added these said it
    // was. config.kdl also binds Mod+Shift+H/J/K/L to the same four actions and
    // nothing shadows those, so focus-monitor has always been reachable by the
    // vim keys. The sweep that found this compares KEYS, not ACTIONS: it can
    // say "this key no longer does what niri intended" and cannot say "nothing
    // does it any more", and the difference was read past.
    //
    // These stay because the arrow and vim forms are offered side by side
    // throughout - Mod+H and Mod+Left both focus the column to the left - so
    // restoring the arrow half completes a pattern rather than duplicating one.
    //
    // Mod+Alt+arrows because they were the only arrow combination still free:
    // Mod, Mod+Shift and Mod+Ctrl are all taken by column and workspace
    // motion. Mod+Alt is otherwise used only by Super+Alt+L and Super+Alt+S in
    // config.kdl - written with Super rather than Mod, which is the same key
    // and worth knowing, because a grep for "Mod+Alt" finds neither.
    //
    // HARMLESS WHERE THERE IS ONE MONITOR. niri simply has nowhere to move the
    // focus to, so the bind does nothing rather than erroring - which is why
    // this lives here and not in a per-machine file.
    Mod+Alt+Left  hotkey-overlay-title="Focus the monitor to the left"  { focus-monitor-left; }
    Mod+Alt+Right hotkey-overlay-title="Focus the monitor to the right" { focus-monitor-right; }
    Mod+Alt+Up    hotkey-overlay-title="Focus the monitor above"        { focus-monitor-up; }
    Mod+Alt+Down  hotkey-overlay-title="Focus the monitor below"        { focus-monitor-down; }

    // DROPPED, with the reason, so nobody hunts for them:
    //   Mod+P              Hyprland's pseudo-tiling. niri has no such mode.
    //   Mod+Escape         a submap for passthrough. niri has no submaps; the
    //                      nearest is toggle-keyboard-shortcuts-inhibit, which
    //                      is a different thing - it lets the FOCUSED CLIENT
    //                      grab the keys rather than suspending the whole map.
    //   Mod+mouse drag     Hyprland bound move and resize to Mod plus a button.
    //                      niri does this natively and not as a bind.

    // --- brightness, which must work with the screen locked ---------------
    //
    // The OSD call is what makes the bar show the level; backlight.sh does the
    // work. repeat=true because holding the key should keep changing it, which
    // is `repeating = true` on the Hyprland side.
    XF86MonBrightnessUp allow-when-locked=true repeat=true hotkey-overlay-title="Brightness up" {
        spawn-sh "$HOME/Work/fd44_hyprdot/bin/backlight.sh set 5%+ && qs ipc call osd brightness"
    }
    XF86MonBrightnessDown allow-when-locked=true repeat=true hotkey-overlay-title="Brightness down" {
        spawn-sh "$HOME/Work/fd44_hyprdot/bin/backlight.sh set 5%- && qs ipc call osd brightness"
    }

    // --- volume, which must work with the screen locked -------------------
    //
    // The same three commands hypr/binds.lua uses, including the detail that is
    // easy to lose: RAISING PASSES `-l 1` AND LOWERING DOES NOT. That caps the
    // volume at 100% when going up, while leaving the cap off on the way down so
    // a sink already above 100% can be brought back rather than being clamped
    // silently.
    //
    // `qs ipc call osd volume` is what shows the slider - the bar does not watch
    // the sink for this, it is told. Which is why these keys must each run both
    // halves, and why a volume key that works while the OSD does not appear means
    // the IPC half failed, not the audio half.
    XF86AudioRaiseVolume allow-when-locked=true repeat=true hotkey-overlay-title="Volume up" {
        spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && qs ipc call osd volume"
    }
    XF86AudioLowerVolume allow-when-locked=true repeat=true hotkey-overlay-title="Volume down" {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && qs ipc call osd volume"
    }
    XF86AudioMute allow-when-locked=true repeat=true hotkey-overlay-title="Mute" {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && qs ipc call osd volume"
    }

    // --- screenshots ------------------------------------------------------
    //
    // niri HAS its own screenshot actions, and these use grim and slurp anyway,
    // because the Hyprland binds did: the same behaviours and the same
    // clipboard. Changing to niri's built-ins would change where things land
    // and what ends up on the clipboard, which is not a port.
    //
    // ALL THREE GO THROUGH bin/screenshot.sh NOW, and what changed is that they
    // answer. The old binds were `grim ... | wl-copy` and said nothing at all,
    // so a capture and a missed selection looked identical until you pasted
    // somewhere to find out; two of the three also threw the image away, and
    // the third wrote a file without ever naming it.
    //
    // Every one of them now keeps the file AND copies it, and shows a toast
    // with the capture in it - which is the only way to see that slurp caught
    // the rectangle you meant. Clicking the toast opens the file.
    //
    // THE REGION BIND KEEPS Mod+Shift+P. It is the one that gets used, the
    // muscle memory is years old, and it is the behaviour that changed least.
    Print hotkey-overlay-title="Screenshot: this screen" { spawn-sh "$HOME/.config/fd44/bin/screenshot.sh screen"; }
    Mod+Shift+P hotkey-overlay-title="Screenshot: a region" { spawn-sh "$HOME/.config/fd44/bin/screenshot.sh region"; }
    Mod+Ctrl+P hotkey-overlay-title="Screenshot: this window" { spawn-sh "$HOME/.config/fd44/bin/screenshot.sh window"; }
}
