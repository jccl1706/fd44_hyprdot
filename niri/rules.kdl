// =========================================================================
// niri window rules - which windows open floating, and where
// =========================================================================
//
// Include this from ~/.config/niri/config.kdl:
//
//     include "rules.kdl"
//
// The counterpart to hypr/rules.lua. niri/look.kdl holds the rule that applies
// to EVERY window - corner radius and clipping - because that is appearance;
// this file holds the ones that single out an application, because that is
// behaviour. Both are window-rule blocks and niri applies them in order, which
// is unlike the input and layout sections: those exist once and a second one is
// ignored, as niri/input.kdl explains at some length.
//
// AN app-id HERE IS MEASURED, NEVER REMEMBERED. Every one in this file was read
// off `niri msg windows` against the running application on fedora-gaming00.

// --- Steam ------------------------------------------------------------------
//
// THE WHOLE CLIENT FLOATS. Steam is one X11 application that opens a lot of
// small toplevels - Friends List, Special Offers, Settings, the screenshot
// uploader, one window per chat - and every one of them arrives as a normal
// toplevel with the same app-id. In a scrolling layout each takes a column of
// its own and pushes real work off the strip; hypr/rules.lua records two doing
// exactly that within a minute of the first login.
//
// THE app-id IS "steam", LOWERCASE, measured here under xwayland-satellite -
// the same string Hyprland reports as the class, so the two configurations
// agree for once without either of them guessing.
//
// GAMES ARE DELIBERATELY NOT MATCHED, so a game is never forced to float.
// Steam gives a game its own app-id of the form steam_app_<appid>, which this
// anchored regex does not match.
//
// ONE DELIBERATE DIFFERENCE FROM HYPRLAND. hypr/rules.lua also pins the client
// to workspace 5 and relies on misc:initial_workspace_tracking to carry games
// there with it. niri has no equivalent of that tracking, so pinning the client
// alone would separate Steam from the games it launches rather than keep them
// together - half a behaviour, which is worse than none. Add
// `open-on-workspace "5"` to this block if you want the client pinned anyway;
// the workspaces are named in niri/workspaces.kdl.
window-rule {
    match app-id=r#"^steam$"#
    open-floating true
    open-on-workspace "5"
}

// --- and the games with it --------------------------------------------------
//
// THE SECOND HALF OF WHAT HYPRLAND GETS FOR FREE. There, Steam is pinned to
// workspace 5 and misc:initial_workspace_tracking carries every game to the
// workspace of the process that launched it - GameThread <- reaper <- steam -
// so the client and its games end up together without a rule naming games at
// all. niri has no equivalent, so pinning only the client would scatter the
// games across whatever workspace happened to be focused. Both halves are
// named here or neither is worth having.
//
// MATCHED ON THE PREFIX, because Steam gives each game an app-id of the form
// steam_app_<appid> - steam_app_1808500 is ARC Raiders, read off
// `niri msg windows` while it ran. The appid differs per game, so the prefix
// is the only stable part.
//
// NOT FLOATED, deliberately. The rule above floats the client because it opens
// a swarm of small windows; a game is one window that wants the whole screen
// and already gets it - measured at 2560x1440 against a 2560x1440 output.
// Floating it would be forcing a decision the game has already made correctly.
// AND OPENED FULLSCREEN, which is not the same as being the size of the
// screen. ARC Raiders came up as a tiled window measuring exactly 2560x1440
// against a 2560x1440 output and still was not fullscreen: the bar stayed
// drawn on top of it and the picture sat below a black band. A window filling
// the output and a window in the fullscreen state are different things, and
// only the second one covers a layer-shell surface.
//
// `niri msg action fullscreen-window` on the running game changed nothing,
// while the same action on a kitty window took it from 1256x1356 to 2560x1440
// and hid the bar - so the mechanism worked and the request was not reaching
// this X11 client. Asking at map time is a different path from toggling an
// already-mapped window.
//
// CONFIRMED on relaunch: the bar is covered and the picture fills the screen.
// The black bars left top and bottom are symmetric, which is the tell - that
// is the cutscene's own cinematic ratio. The fault this rule fixes showed as a
// band at the TOP ONLY, offset by exactly the space the bar had reserved.
//
// IF A GAME STILL COMES UP LETTERBOXED ASYMMETRICALLY, the remaining lever is
// its own display mode: "Fullscreen" rather than "Borderless Window". No rule
// here can override a client that has decided it is a window on a desktop.
window-rule {
    match app-id=r#"^steam_app_"#
    open-on-workspace "5"
    open-fullscreen true
}

// IF STEAM'S MENUS DO NOT OPEN, IT IS NOT THIS RULE. That is the first thing
// anyone will suspect, because the symptom appears the moment the client starts
// floating and every menu - Steam, View, Friends, Games, Help, every
// right-click - flashes and vanishes.
//
// It is xwayland-satellite 0.8.2, which tells an X11 override-redirect popup
// that the pointer left it about 35ms after it maps:
//
//   https://github.com/Supreeeme/xwayland-satellite/issues/503
//   https://github.com/niri-wm/niri/issues/4532
//
// Measured on fedora-gaming00: broken on 0.8.2, fine on 0.8.1. Steam's own
// -system-composer workaround changed nothing. install/fedora_desktop.sh holds
// the package at 0.8.1 and locks it, and says when to remove that - the fix is
// already in xwayland-satellite main and will arrive in a Fedora build.

// --- Chromium, on workspace 2 ------------------------------------------------
//
// THE app-id IS "chromium-browser", NOT "chromium". Measured with
// `niri msg windows` against the running browser on the Framework. Fedora's
// package installs the binary as /usr/bin/chromium-browser and names the
// window to match - there is no `chromium` command at all, which is also how
// the first attempt to launch it for this measurement failed.
//
// NOT FLOATED and not sized: this only says where it opens. A browser is a
// window you work in, so it takes its share of the column strip like anything
// else - the rule exists so it opens in the same place every time rather than
// wherever the focus happened to be.
//
// The workspaces are named in niri/workspaces.kdl; "2" is a name, not an index.
// AND FULL WIDTH, which is not the same as fullscreen and not the same as the
// maximized state Chromium asks for itself.
//
// Three things that all look like "big" and are not:
//
//   open-maximized    niri makes the COLUMN full width. Measured here as
//                     1472x919 - the working area minus the 32px of gaps -
//                     with the bar visible and the corners rounded.
//   open-fullscreen   covers the output, 1504x1002, over the bar. What a game
//                     wants; not what a browser wants.
//   the client asking the window manager to maximize it, which is what
//                     Chromium did out of the box: 1504x951, the full working
//                     area with the gaps skipped and the corners clipped
//                     against the screen edge. That one was turned off in
//                     ~/.config/chromium/Default/Preferences
//                     (browser.window_placement.maximized), because a client
//                     deciding this for itself overrides anything set here.
window-rule {
    match app-id=r#"^chromium-browser$"#
    open-on-workspace "2"
    open-maximized true
}
