// =========================================================================
// niri look - decorations
// =========================================================================
//
// Include this from ~/.config/niri/config.kdl:
//
//     include "~/Work/fd44_hyprdot/niri/look.kdl"
//
// NO TITLE BARS, which on Wayland is a negotiation rather than a setting. There
// is no server-side title bar to turn off: niri draws a focus ring and a border
// and never a title bar. What appears instead is the APPLICATION'S OWN
// decoration - client-side decorations, drawn inside its surface.
//
// prefer-no-csd is niri asking clients to omit them, over the xdg-decoration
// protocol. Clients that negotiate decorations server-side - kitty, most Qt
// applications - then draw none and get niri's ring and border instead. It is
// also why windows come up without the compositor's own solid background behind
// their frame.
//
// IT IS A REQUEST, NOT A RULE, and two kinds of window will ignore it:
//
//   - A client that specifically ASKS for CSD is honoured, by design.
//   - GTK applications mostly draw a headerbar regardless and have no SSD path
//     at all. Nautilus keeps its header here exactly as it does under Hyprland,
//     so this changes nothing about those - they were never niri's doing.
//
// It also tells clients they are tiled, which removes some rounded corners that
// a floating window would otherwise draw for itself.
prefer-no-csd

// A SECOND THING THE CLIENT DECIDES, AND IT LOOKS LIKE A BUG IN THESE RULES.
//
// A window that comes up filling the screen - no gaps, corners square against
// the edges - has usually not escaped the rules below. It asked to be
// maximized, and niri honoured it by handing over the whole working area,
// which is drawn without gaps; the corner radius is then rounding against the
// screen edge where it cannot be seen.
//
// GTK applications remember that state across sessions, so maximizing one once
// makes every later window open that way. Nautilus keeps it in GSettings:
//
//     gsettings get org.gnome.nautilus.window-state maximized
//     gsettings set org.gnome.nautilus.window-state maximized false
//
// Measured on the Framework, where it had been true and the desktop's fresh
// install still had it false - which is the whole reason the same Nautilus
// looked different on two machines built from this repository:
//
//     maximized true    tile 1504 x 951   full working area, no gaps
//     maximized false   tile  728 x 919   the same as every other window
//
// NIRI'S OWN MAXIMIZE IS NOT THIS. Maximizing a column with Mod+F gives
// 1472 x 919 - the working area minus the 32px of gaps - and keeps its
// corners. Only the client-side request bypasses them, so "maximized" means
// two different things here depending on who asked, and one of them is
// indistinguishable from a window rule that did not apply.
//
// It is per-user state, not configuration, so it does not travel with this
// repository and a fresh machine will not have it.

// ROUNDED CORNERS, 10px, which is hypr/look.lua's `rounding = 10`.
//
// TWO SETTINGS, NOT ONE, and the second is the one that is easy to miss.
// geometry-corner-radius rounds the GEOMETRY niri draws - the focus ring and the
// border - while the window's own content is still a rectangle underneath, so on
// its own it leaves square corners poking out of rounded ones.
// clip-to-geometry clips the surface to that shape, which is what actually
// rounds the window.
//
// A WINDOW RULE WITH NO MATCH applies to every window, which is what Hyprland's
// single `rounding` value does too.
//
// Hyprland also sets rounding_power = 2, the exponent of the corner curve - 2 is
// a plain circular arc. niri's radius has no such control, so a squircle is not
// available here; at 10px the difference is not visible.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// NO FOCUS RING AND NO BORDER, which is hypr/look.lua's `border_size = 0`.
//
// niri draws TWO things that Hyprland's single border_size covers. The focus ring
// is drawn around the ACTIVE window only and does not change its size; the border
// is drawn around every window and shrinks them to make room. niri ships with the
// ring on at 4px and the border off, so a fresh niri has an outline the Hyprland
// setup does not.
//
// Both are turned off here. The cost is real and worth stating: with neither, a
// window carries no indication that it is focused. That is the same trade the
// Hyprland side makes at border_size = 0, where the bar's focused-app readout and
// the cursor are what tell you - so it is the trade already being lived with, not
// a new one.
//
// The layout block MERGES with the one in niri's own config, so this turns the
// ring off without restating its width, colours or anything else.
layout {
    focus-ring {
        off
    }

    border {
        off
    }
}

// NO HOTKEY HELP AT STARTUP. niri shows an "Important Hotkeys" panel every time
// it starts, which is useful exactly once. Super+Shift+Slash still opens it on
// demand - that bind is niri's own and is left alone.
//
// hide-not-bound is set with it: the overlay lists niri's standard hotkeys
// whether or not this config binds them, so without this it advertises keys that
// do nothing here. With it, the panel shows what is actually bound.
hotkey-overlay {
    skip-at-startup
    hide-not-bound
}
