# /etc/conf.d/libvirtd

# Startup dependency
# libvirtd typically requires all networks to be up and settled which
# is what rc_need="net" provides. However if you only use specific networks
# for libvirtd, you may override this. Or if you only use libvirtd locally.
# Shipped as rc_need="net", which deadlocks on this machine: NetworkManager
# provides "net" but marks itself inactive after INACTIVE_TIMEOUT=1 so it does
# not hold up the boot, and never flips to "started" afterwards. libvirtd then
# waits for a state that never arrives - "libvirtd will start when
# NetworkManager has started" - and that would happen at every boot.
#
# Ordering is kept with rc_after: libvirtd still starts after networking when
# networking is there, it just no longer refuses to start without it. Right for
# this machine anyway, since libvirt builds its own virbr0 and does not need the
# host uplink up first.
rc_need=""
rc_after="net"

# The termination timeout (start-stop-daemon parameter "retry") ensures
# that the service will be terminated within a given time (25 + 5 seconds
# per default) when you are stopping the service.
#LIBVIRTD_TERMTIMEOUT="TERM/25/KILL/5"

# LIBVIRTD_OPTS
# You may want to add '--listen' to have libvirtd listen for tcp/ip connections
# if you want to use libvirt for remote control
# Please consult 'libvirtd --help' for more options
#LIBVIRTD_OPTS="--listen"
